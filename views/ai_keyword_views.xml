<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_blog_keyword_list" model="ir.ui.view">
        <field name="name">ai.blog.keyword.list</field>
        <field name="model">ai.blog.keyword</field>
        <field name="arch" type="xml">
            <list string="Keywords" editable="bottom">
                <field name="name"/>
                <field name="note"/>
            </list>
        </field>
    </record>

    <record id="view_ai_blog_keyword_form" model="ir.ui.view">
        <field name="name">ai.blog.keyword.form</field>
        <field name="model">ai.blog.keyword</field>
        <field name="arch" type="xml">
            <form string="Keyword">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="note"/>
                        <field name="active" widget="boolean_toggle"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_blog_keyword_search" model="ir.ui.view">
        <field name="name">ai.blog.keyword.search</field>
        <field name="model">ai.blog.keyword</field>
        <field name="arch" type="xml">
            <search string="Keywords">
                <field name="name"/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_ai_blog_keyword" model="ir.actions.act_window">
        <field name="name">Keywords</field>
        <field name="res_model">ai.blog.keyword</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add the keywords the Sniffer agent will monitor
            </p>
            <p>
                These keywords drive the news monitoring. The Sniffer uses them
                to find relevant topics and generate blog proposals.
            </p>
        </field>
    </record>

    <!-- Root menu -->
    <menuitem id="menu_blog_ai_root"
              name="Blog AI"
              sequence="90"/>

    <menuitem id="menu_blog_ai_configuration"
              name="Configuration"
              parent="menu_blog_ai_root"
              sequence="90"/>

    <menuitem id="menu_ai_blog_keyword"
              name="Keywords"
              parent="menu_blog_ai_configuration"
              action="action_ai_blog_keyword"
              sequence="10"/>

</odoo>
